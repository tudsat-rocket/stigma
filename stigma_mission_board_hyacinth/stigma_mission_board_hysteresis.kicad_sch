	)
	(text "Here, we measure the current and the voltage of the main voltage \nand voltage of the high_current power source. \n\nThe current is measured with the current-sense amplifier\nThe voltage is measured with a voltage divider. \nFor this, the following formula applies: \nmeasuring_voltage = (R2) / (R1 + R2) * input voltage"
		(exclude_from_sim no)
		(at 205.486 62.484 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0f228927-aeef-4e6a-840e-6eed02bfee4f")
	)
